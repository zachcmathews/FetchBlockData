<Project>
  <PropertyGroup>
    <AutoCADVersion Condition="'$(AutoCADVersion)' == ''">2027</AutoCADVersion>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <Choose>
    <When Condition="'$(AutoCADVersion)' == '2026' Or '$(AutoCADVersion)' == '2026.0.1' Or '$(AutoCADVersion)' == '2026.1' Or '$(AutoCADVersion)' == '2026.1.1'">
      <PropertyGroup>
        <AutoCADBuildVersion>2026</AutoCADBuildVersion>
        <TargetFramework>net8.0-windows</TargetFramework>
        <AutoCadPackageVersion>25.1.0</AutoCadPackageVersion>
      </PropertyGroup>
    </When>
    <When Condition="'$(AutoCADVersion)' == '2026.1.2'">
      <PropertyGroup>
        <AutoCADBuildVersion>2026.1.2</AutoCADBuildVersion>
        <AutoCadPackageVersion>25.1.1</AutoCadPackageVersion>
      </PropertyGroup>
    </When>
    <When Condition="'$(AutoCADVersion)' == '2027' Or '$(AutoCADVersion)' == '2027.1' Or '$(AutoCADVersion)' == '2027.1.1'">
      <PropertyGroup>
        <AutoCADBuildVersion>2027</AutoCADBuildVersion>
        <AutoCadPackageVersion>26.0.0</AutoCadPackageVersion>
      </PropertyGroup>
    </When>
  </Choose>

  <PropertyGroup>
    <BaseOutputPath>bin/AutoCAD-$(AutoCADBuildVersion)/</BaseOutputPath>
    <BaseIntermediateOutputPath>obj/AutoCAD-$(AutoCADBuildVersion)/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
